<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MALClient.Maui.Views.CharacterSearchView">
    <Grid RowDefinitions="Auto,Auto,*">
        <SearchBar x:Name="QueryInput" Placeholder="Search characters..." SearchButtonPressed="QueryOnSubmitted"
                   AutomationId="CharacterSearchInput" />
        <HorizontalStackLayout Grid.Row="1" Spacing="16" Padding="16,0">
            <RadioButton Content="Anime" CheckedChanged="AnimeOnCheckedChanged" />
            <RadioButton Content="Manga" CheckedChanged="MangaOnCheckedChanged" />
            <RadioButton Content="Characters" IsChecked="True" />
        </HorizontalStackLayout>
        <CollectionView Grid.Row="2" x:Name="Results" ItemsSource="{Binding FoundCharacters}"
                        SelectionMode="Single" SelectionChanged="ResultsOnSelectionChanged"
                        AutomationId="CharacterSearchResults">
            <CollectionView.EmptyView>
                <Grid>
                    <ActivityIndicator IsRunning="{Binding Loading}" VerticalOptions="Center" />
                    <Label Text="No characters found." IsVisible="{Binding IsEmptyNoticeVisible}"
                           HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Label Text="Type at least 3 characters to search." IsVisible="{Binding IsFirstVisitGridVisible}"
                           HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="24" />
                </Grid>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8" ColumnDefinitions="64,*" ColumnSpacing="12">
                        <Image Source="{Binding Data.ImgUrl}" Aspect="AspectFill" HeightRequest="90" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Data.Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Data.Notes}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
