<?xml version="1.0" encoding="utf-8"?>
<!-- WinUI 3 dropped Reveal highlight. These keep the UWP style/brush keys used across the ported pages
     resolving to the regular WinUI equivalents. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ButtonRevealStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}" />
    <Style x:Key="ToggleButtonRevealStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}" />
    <Style x:Key="CommandBarRevealStyle" TargetType="CommandBar" BasedOn="{StaticResource DefaultCommandBarStyle}" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="ButtonRevealBackground" ResourceKey="ButtonBackground" />
            <StaticResource x:Key="ButtonRevealBackgroundPointerOver" ResourceKey="ButtonBackgroundPointerOver" />
            <StaticResource x:Key="ButtonRevealBackgroundPressed" ResourceKey="ButtonBackgroundPressed" />
            <StaticResource x:Key="ButtonRevealBackgroundDisabled" ResourceKey="ButtonBackgroundDisabled" />
            <StaticResource x:Key="ButtonRevealBorderBrush" ResourceKey="ButtonBorderBrush" />
            <StaticResource x:Key="ButtonRevealBorderBrushDisabled" ResourceKey="ButtonBorderBrushDisabled" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="ButtonRevealBackground" ResourceKey="ButtonBackground" />
            <StaticResource x:Key="ButtonRevealBackgroundPointerOver" ResourceKey="ButtonBackgroundPointerOver" />
            <StaticResource x:Key="ButtonRevealBackgroundPressed" ResourceKey="ButtonBackgroundPressed" />
            <StaticResource x:Key="ButtonRevealBackgroundDisabled" ResourceKey="ButtonBackgroundDisabled" />
            <StaticResource x:Key="ButtonRevealBorderBrush" ResourceKey="ButtonBorderBrush" />
            <StaticResource x:Key="ButtonRevealBorderBrushDisabled" ResourceKey="ButtonBorderBrushDisabled" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
